# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the gateway listens on (1-65535)
PORT=4000

# Service identity used in health checks and logs
SERVICE_NAME=api-resilience-platform

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Gateway: how often upstream /health endpoints are probed (ms)
HEALTH_CHECK_INTERVAL_MS=5000

# Gateway: hard deadline for any single upstream request (ms) -> 504 on breach
UPSTREAM_TIMEOUT_MS=3000

# Retry policy. maxAttempts INCLUDES the initial request (3 = 1 + 2 retries).
RETRY_MAX_ATTEMPTS=3

# Exponential backoff: delay = base * 2^(failedAttempt-1), capped at max.
# Equal jitter is applied on top (half fixed, half random).
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=1000

# Wall-clock ceiling for one full proxy call incl. all retries and backoff (ms)
RETRY_TOTAL_BUDGET_MS=10000

# Optional per-service URL overrides (defaults target the local simulators)
# PAYMENT_SERVICE_URL=http://localhost:4101
# AI_SERVICE_URL=http://localhost:4102
# NOTIFICATION_SERVICE_URL=http://localhost:4103
