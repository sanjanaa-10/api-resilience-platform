# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the gateway listens on
PORT=4000

# Service identity used in health checks and logs
SERVICE_NAME=api-resilience-platform

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Health monitoring
HEALTH_CHECK_INTERVAL_MS=5000

# Upstream timeout
UPSTREAM_TIMEOUT_MS=3000

# Retry policy
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=100
RETRY_MAX_DELAY_MS=1000
RETRY_TOTAL_BUDGET_MS=10000

# Upstream service URLs
PAYMENT_SERVICE_URL=http://localhost:4101
AI_SERVICE_URL=http://localhost:4102
AI_FALLBACK_SERVICE_URL=http://localhost:4104
NOTIFICATION_SERVICE_URL=http://localhost:4103

# Rate limiting
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=10
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

# Circuit breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_DURATION_MS=10000
CIRCUIT_BREAKER_HALF_OPEN_MAX_REQUESTS=1

# Observability
EVENTS_CAPACITY=2000
METRICS_LATENCY_WINDOW=200

# Incident detection
INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_LOOKBACK_MS=60000
INCIDENT_RECOVERY_QUIET_MS=10000
INCIDENT_MAX_RESOLVED=100

# Anomaly detection
ANOMALY_SAMPLE_INTERVAL_MS=5000
ANOMALY_WINDOW_SIZE=30
ANOMALY_MIN_SAMPLES=10
ANOMALY_SCORE_WARNING=0.5
ANOMALY_SCORE_ANOMALOUS=0.8